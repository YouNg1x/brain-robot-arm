<?xml version="1.0"?>
<sdf version="1.7">
  <model name="red_ball">
    <static>false</static>
    <link name="ball_link">
      <gravity>false</gravity>
      <inertial>
        <mass>{ball_mass}</mass>
        <inertia>
          <ixx>{ball_inertia}</ixx><iyy>{ball_inertia}</iyy><izz>{ball_inertia}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="ball_collision"><geometry><sphere><radius>{ball_radius}</radius></sphere></geometry></collision>
      <visual name="ball_visual">
        <geometry><sphere><radius>{ball_radius}</radius></sphere></geometry>
        <material><ambient>0.85 0.04 0.03 1</ambient><diffuse>0.98 0.08 0.05 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>
    </link>
    <plugin name="ball_pose_plugin" filename="libcup_pose_plugin.so">
      <ros><namespace>/brain_robot_ball_pick</namespace></ros>
      <topic>ball_target_pose</topic>
    </plugin>
  </model>
</sdf>
