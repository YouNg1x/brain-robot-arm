<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <!-- Reuse the official PiPER Gazebo model and add only the simulated wrist camera. -->
  <xacro:include filename="$(find piper_description)/urdf/piper_description_gazebo.xacro" />

  <link name="wrist_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.045 0.030 0.025" />
      </geometry>
      <material name="wrist_camera_black">
        <color rgba="0.05 0.05 0.05 1.0" />
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8" />
    </inertial>
  </link>

  <!-- Gazebo cameras look along link +X. This rotation aligns +X with gripper_base +Z. -->
  <joint name="gripper_to_wrist_camera" type="fixed">
    <parent link="gripper_base" />
    <child link="wrist_camera_link" />
    <origin xyz="-0.055 0 0.075" rpy="0 -1.57079632679 0" />
  </joint>

  <gazebo reference="gripper_to_wrist_camera">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <link name="wrist_camera_optical_frame" />
  <joint name="wrist_camera_optical_joint" type="fixed">
    <parent link="wrist_camera_link" />
    <child link="wrist_camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>

  <gazebo reference="wrist_camera_link">
    <sensor name="wrist_rgbd_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>20.0</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.0471975512</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </camera>
      <plugin name="wrist_rgbd_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/wrist_camera</namespace>
        </ros>
        <camera_name>wrist_camera</camera_name>
        <frame_name>wrist_camera_optical_frame</frame_name>
        <min_depth>0.05</min_depth>
        <max_depth>3.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>
</robot>
